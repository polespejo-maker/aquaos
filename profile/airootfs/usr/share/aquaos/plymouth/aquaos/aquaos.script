# ============================================================================
#  AquaOS · splash de arranque (tema "script" de Plymouth)
#
#  Fondo con degradado azul, logo centrado, título y barra de progreso.
#  El texto de estado del arranque se muestra debajo de la barra.
#
#  API: https://www.freedesktop.org/wiki/Software/Plymouth/
# ============================================================================

# --- fondo -----------------------------------------------------------------
Window.SetBackgroundTopColor(0.035, 0.055, 0.105);
Window.SetBackgroundBottomColor(0.075, 0.145, 0.255);

# --- imágenes --------------------------------------------------------------
logo_image    = Image("logo.png").Scale(96, 96);
title_image   = Image.Text("AquaOS", 0.96, 0.98, 1.0, 1.0, "Noto Sans Bold 20");
subtitle_image = Image.Text("Linux con alma de macOS", 0.62, 0.71, 0.86, 1.0, "Noto Sans 10");
bar_bg_image  = Image("bar-background.png");
bar_fill_image = Image("bar-fill.png");
message_image = Image.Text("", 0.80, 0.86, 0.95, 1.0, "Noto Sans 10");

# --- sprites ---------------------------------------------------------------
logo.sprite = Sprite(logo_image);
title.sprite = Sprite(title_image);
subtitle.sprite = Sprite(subtitle_image);
bar_bg.sprite = Sprite(bar_bg_image);
bar_fill.sprite = Sprite();
bar_fill.sprite.SetOpacity(0);
message.sprite = Sprite(message_image);
message.sprite.SetOpacity(0);

# --- colocación ------------------------------------------------------------
fun layout()
  {
    local.cx = Window.GetX() + Window.GetWidth() / 2;
    local.cy = Window.GetY() + Window.GetHeight() / 2;
    local.top = cy - 150;

    logo.sprite.SetPosition(cx - logo_image.GetWidth() / 2, top, 100);
    title.sprite.SetPosition(cx - title_image.GetWidth() / 2, top + 108, 100);
    subtitle.sprite.SetPosition(cx - subtitle_image.GetWidth() / 2, top + 142, 100);

    local.bar_x = cx - bar_bg_image.GetWidth() / 2;
    local.bar_y = cy + 42;
    bar_bg.sprite.SetPosition(bar_x, bar_y, 100);
    bar_fill.sprite.SetPosition(bar_x, bar_y, 101);

    if (message_image)
      message.sprite.SetPosition(cx - message_image.GetWidth() / 2, bar_y + 26, 100);
  }

layout();

# --- refresco (Plymouth lo necesita para repintar) -------------------------
fun refresh_callback()
  {
    layout();
  }

Plymouth.SetRefreshFunction(refresh_callback);

# --- progreso de arranque --------------------------------------------------
fun progress_callback(duration, progress)
  {
    if (progress <= 0)
      {
        bar_fill.sprite.SetOpacity(0);
        return;
      }

    local.width = Math.Int(bar_fill_image.GetWidth() * progress);
    if (width < 2)
      width = 2;

    bar_fill.sprite.SetImage(bar_fill_image.Scale(width, bar_fill_image.GetHeight()));
    bar_fill.sprite.SetOpacity(1);
  }

Plymouth.SetBootProgressFunction(progress_callback);

# --- mensajes del sistema --------------------------------------------------
fun message_callback(text)
  {
    if (!text || text == "")
      return;

    message_image = Image.Text(text, 0.80, 0.86, 0.95, 1.0, "Noto Sans 10");
    message.sprite.SetImage(message_image);
    message.sprite.SetOpacity(1);
    layout();
  }

fun hide_message_callback(text)
  {
    message.sprite.SetOpacity(0);
  }

Plymouth.SetDisplayMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# --- contraseña (por si algún día se activa LUKS) --------------------------
fun display_password_callback(prompt, bullets)
  {
    local.entry = "";
    local.i = 0;
    while (i < bullets)
      {
        entry = entry + "●";
        i = i + 1;
      }

    message_image = Image.Text(prompt + "  " + entry, 0.80, 0.86, 0.95, 1.0, "Noto Sans 11");
    message.sprite.SetImage(message_image);
    message.sprite.SetOpacity(1);
    layout();
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
