[org.kde.kdecoration2]
# Botones a la izquierda y en orden macOS: cerrar, minimizar, maximizar
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSize=None
BorderSizeAuto=false
ShowToolTips=false
NoSideBorder=true

[Windows]
AutoRaise=false
ClickRaise=true
RollOverDesktops=true
FocusStealingPreventionLevel=1
Placement=Centered

[Plugins]
blurEnabled=true
contrastEnabled=false
diminactiveEnabled=true
dialogparentEnabled=true
slidingpopupsEnabled=true
scaleEnabled=true
fadeEnabled=true
fadingpopupsEnabled=true
kwin4_effect_translucencyEnabled=false
wobblywindowsEnabled=false

[Effect-blur]
BlurStrength=9
NoiseStrength=2

[Effect-diminactive]
Strength=0.15

[Compositing]
Enabled=true
LatencyPolicy=Low
